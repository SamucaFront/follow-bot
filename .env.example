# Só para rodar no seu computador. No GitHub Actions use Secrets e Variables, nunca este arquivo.
# Copie para .env (que está no .gitignore) e preencha. NUNCA faça commit do .env.

# Token fine-grained da sua conta com permissão "Followers: Read and write"
GH_USER_TOKEN=
# Token com acesso a Issues (read and write) no repositório do bot. Localmente pode ser o mesmo token
# se ele tiver acesso ao repositório.
GITHUB_TOKEN=
# dono/repositorio
GITHUB_REPOSITORY=seu-usuario/follow-bot

BOT_ENABLED=true
DRY_RUN=true
DATA_DIR=data
LOG_FILE=logs/bot.log
